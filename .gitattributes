* text=auto eol=lf
*.bat text eol=crlf
*.iss text eol=crlf
installer/after_install.txt text eol=crlf
*.jsx text eol=lf
*.docx binary
*.png binary
*.jpg binary

# вендоренные зависимости — не трогаем переносы строк
node_modules/** -text

